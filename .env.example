# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Auth0 (Arya) — from Auth0 dashboard > Applications > LeaseCheck > Settings
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Random 32-byte hex string. Generate with: openssl rand -hex 32
AUTH0_SECRET=
# http://localhost:3000 locally; your Vercel URL or domain when deployed
APP_BASE_URL=http://localhost:3000

# --- Gemini (Samuel) — from aistudio.google.com > Get API key
GEMINI_API_KEY=

# Frontend (James) — set to false to use the real /api/check instead of mock-result.json
NEXT_PUBLIC_USE_MOCK=true
